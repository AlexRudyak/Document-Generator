# Copy to .env and adjust. run.py loads .env automatically (python-dotenv).

# Flask session signing key. REQUIRED in production — generate a random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLAlchemy database URL. Defaults to a local SQLite file (app.db).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/docgen

# Max upload size for figure/signature images, in bytes (default 10 MiB).
# MAX_CONTENT_LENGTH=10485760

# Absolute path to a TTF font that can render Hebrew. If unset, the app searches
# common OS font locations, then the bundled DejaVu Sans, then falls back to
# Helvetica (no Hebrew). HEBREW_FONT_BOLD_PATH is optional.
# HEBREW_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# HEBREW_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Override where the database / uploads are stored (defaults: project root when
# run from source, per-user app-data dir in a frozen build).
# DOCGEN_DATA_DIR=/var/lib/docgen
# DOCGEN_UPLOAD_DIR=/var/lib/docgen/uploads

# Dev server only (run.py):
# FLASK_DEBUG=1
# PORT=5000
